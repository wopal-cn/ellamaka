    "test:integration": "bun test test/plugins-runtime.test.ts test/dsh-web.test.ts test/bun-ptc-runtime.test.ts test/dsh-adapter-runtime.test.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./hub": "./src/hub.ts",
    "./types": "./src/types.ts",
