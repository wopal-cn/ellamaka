  "files": [
    "dist"
  ],
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@npmcli/arborist": "9.4.0",
    "@wopal/ellamaka-core": "workspace:*",
    "@wopal/ellamaka-plugin": "workspace:*",
    "amaro": "1.1.8",
    "chokidar": "4.0.3",
    "diff": "catalog:",
