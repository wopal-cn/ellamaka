    "./dsh-adapter/host": "./src/dsh-adapter/host.ts",
    "./runtime": "./src/runtime/manager.ts",
    "./runtime/loader": "./src/runtime/loader.ts",
    "./plugins": "./src/plugins/profile-manifest.ts",
    "./plugins/compose": "./src/plugins/compose.ts",
    "./plugins/resolve-specifiers": "./src/plugins/resolve-specifiers.ts",
    "./plugins/install-command": "./src/plugins/install-command.ts",
    "./plugins/runtime": "./src/plugins/runtime.ts",
