// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode acp --help 1`] = `
"ellamaka acp

start ACP (Agent Client Protocol) server

Options:
  -h, --help                show help                                                      [boolean]
  -v, --version             show version number                                            [boolean]
      --print-logs          print logs to stderr                                           [boolean]
      --log-level           log level  [string] [choices: "TRACE", "DEBUG", "INFO", "WARN", "ERROR"]
      --trace               trace categories (comma-separated, e.g. session,llm); run \`--trace\`
                            alone to list them                                              [string]
      --pure                run without external plugins                                   [boolean]
      --disable-wopalspace  disable WopalSpace mode (use native opencode behavior)         [boolean]
      --port                port to listen on                                  [number] [default: 0]
      --hostname            hostname to listen on                    [string] [default: "127.0.0.1"]
      --mdns                enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain         custom domain name for mDNS service (default: ellamaka.local)
                                                                [string] [default: "ellamaka.local"]
      --cors                additional domains to allow for CORS               [array] [default: []]
      --cwd                 working directory [string] [default: "<HOME>"]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode mcp --help 1`] = `
"ellamaka mcp

manage MCP (Model Context Protocol) servers

Commands:
  ellamaka mcp add            add an MCP server
  ellamaka mcp list           list MCP servers and their status                        [aliases: ls]
  ellamaka mcp auth [name]    authenticate with an OAuth-enabled MCP server
  ellamaka mcp logout [name]  remove OAuth credentials for an MCP server
  ellamaka mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help                show help                                                      [boolean]
  -v, --version             show version number                                            [boolean]
      --print-logs          print logs to stderr                                           [boolean]
      --log-level           log level  [string] [choices: "TRACE", "DEBUG", "INFO", "WARN", "ERROR"]
      --trace               trace categories (comma-separated, e.g. session,llm); run \`--trace\`
                            alone to list them                                              [string]
      --pure                run without external plugins                                   [boolean]
      --disable-wopalspace  disable WopalSpace mode (use native opencode behavior)         [boolean]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode attach --help 1`] = `
"ellamaka attach <url>

attach to a running ellamaka server

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help                show help                                                      [boolean]
  -v, --version             show version number                                            [boolean]
      --print-logs          print logs to stderr                                           [boolean]
      --log-level           log level  [string] [choices: "TRACE", "DEBUG", "INFO", "WARN", "ERROR"]
      --trace               trace categories (comma-separated, e.g. session,llm); run \`--trace\`
                            alone to list them                                              [string]
      --pure                run without external plugins                                   [boolean]
      --disable-wopalspace  disable WopalSpace mode (use native opencode behavior)         [boolean]
      --dir                 directory to run in                                             [string]
  -c, --continue            continue the last session                                      [boolean]
  -s, --session             session id to continue                                          [string]
      --fork                fork the session when continuing (use with --continue or --session)
                                                                                           [boolean]
  -p, --password            basic auth password (defaults to ELLAMAKA_SERVER_PASSWORD)      [string]
  -u, --username            basic auth username (defaults to ELLAMAKA_SERVER_USERNAME or 'ellamaka')
                                                                                            [string]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode run --help 1`] = `
"ellamaka run [message..]

run ellamaka with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help                          show help                                            [boolean]
  -v, --version                       show version number                                  [boolean]
      --print-logs                    print logs to stderr                                 [boolean]
      --log-level                     log level
                                       [string] [choices: "TRACE", "DEBUG", "INFO", "WARN", "ERROR"]
      --trace                         trace categories (comma-separated, e.g. session,llm); run
                                      \`--trace\` alone to list them                          [string]
      --pure                          run without external plugins                         [boolean]
      --disable-wopalspace            disable WopalSpace mode (use native opencode behavior)
                                                                                           [boolean]
      --command                       the command to run, use message for args              [string]
  -c, --continue                      continue the last session                            [boolean]
  -s, --session                       session id to continue                                [string]
      --fork                          fork the session before continuing (requires --continue or
                                      --session)                                           [boolean]
      --share                         share the session                                    [boolean]
  -m, --model                         model to use in the format of provider/model          [string]
      --agent                         agent to use                                          [string]
      --format                        format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file                          file(s) to attach to message                           [array]
      --title                         title for the session (uses truncated prompt if no value
                                      provided)                                             [string]
      --attach                        attach to a running ellamaka server (e.g.,
                                      http://localhost:4096)                                [string]
  -p, --password                      basic auth password (defaults to ELLAMAKA_SERVER_PASSWORD)
                                                                                            [string]
  -u, --username                      basic auth username (defaults to ELLAMAKA_SERVER_USERNAME or
                                      'ellamaka')                                           [string]
      --dir                           directory to run in, path on remote server if attaching
                                                                                            [string]
      --port                          port for the local server (defaults to random port if no value
                                      provided)                                             [number]
      --variant                       model variant (provider-specific reasoning effort, e.g., high,
                                      max, minimal)                                         [string]
      --thinking                      show thinking blocks                                 [boolean]
      --replay                        replay visible session history on interactive resume
                                                                          [boolean] [default: false]
      --replay-limit                  cap visible interactive replay to the newest N messages
                                                                                            [number]
  -i, --interactive                   run in direct interactive split-footer mode
                                                                          [boolean] [default: false]
      --dangerously-skip-permissions  auto-approve permissions that are not explicitly denied
                                      (dangerous!)                        [boolean] [default: false]
      --demo                          enable direct interactive demo slash commands; pass one as the
                                      message to run it immediately       [boolean] [default: false]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode debug --help 1`] = `
"ellamaka debug

debugging and troubleshooting tools

Commands:
  ellamaka debug config        show resolved configuration
  ellamaka debug lsp           LSP debugging utilities
  ellamaka debug rg            ripgrep debugging utilities
  ellamaka debug file          file system debugging utilities
  ellamaka debug scrap         list all known projects
  ellamaka debug skill         list all available skills
  ellamaka debug startup       print startup timing
  ellamaka debug agent <name>  show agent configuration details
  ellamaka debug v2            debug v2 catalog and built-in plugins
  ellamaka debug release-info  output structured release identity as JSON (machine interface)
  ellamaka debug info          show debug information
  ellamaka debug paths         show global paths (data, config, cache, state)
  ellamaka debug wait          wait indefinitely (for debugging)

Options:
  -h, --help                show help                                                      [boolean]
  -v, --version             show version number                                            [boolean]
      --print-logs          print logs to stderr                                           [boolean]
      --log-level           log level  [string] [choices: "TRACE", "DEBUG", "INFO", "WARN", "ERROR"]
      --trace               trace categories (comma-separated, e.g. session,llm); run \`--trace\`
                            alone to list them                                              [string]
      --pure                run without external plugins                                   [boolean]
      --disable-wopalspace  disable WopalSpace mode (use native opencode behavior)         [boolean]"
`;

