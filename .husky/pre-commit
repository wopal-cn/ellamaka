#!/bin/sh
set -eu

# Fast, staged-only checks.
#
# Test suites live in .github/workflows/ci.yml (nightly + manual) and in the
# release gate of the publish workflows. A pre-commit test run is a tax people
# bypass with --no-verify, so it is gone: this hook only lints the staged code
# and scans the staged diff for secrets. Anything that fails here fails the
# commit — there is no escape hatch.

cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

# Static check: the repository's real lint command (oxlint), limited to the
# staged TypeScript/JavaScript files. Newline splitting keeps paths with
# spaces intact; globbing is disabled so a path is never expanded.
set -f
old_ifs=$IFS
IFS='
'
set --
for file in $staged; do
  case "$file" in
    *.ts | *.tsx | *.js | *.jsx | *.mjs | *.cjs) set -- "$@" "$file" ;;
  esac
done
IFS=$old_ifs
set +f

if [ "$#" -gt 0 ]; then
  bun run lint -- "$@"
fi

# Secret scan: pinned gitleaks fetched and checksum-verified by the wrapper.
sh scripts/ci/run-gitleaks.sh
